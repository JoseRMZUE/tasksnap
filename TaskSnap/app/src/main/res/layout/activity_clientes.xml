<?xml version="1.0" encoding="utf-8"?>
<!--
  Gestión de clientes (RF-18, RN-9). API-first: Fase 4 según v1.1.
  Estructura: mitad superior = listado, mitad inferior = formulario.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- ===== ENCABEZADO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorPrimary"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvClientesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestión de Clientes"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== INDICADORES DE ESTADO (API) ===== -->
    <ProgressBar
        android:id="@+id/pbClientes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvClientesError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/colorError"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- ===== LISTADO: mitad superior, ocupa el espacio disponible ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvClientes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/colorDivider"
            android:dividerHeight="1dp"
            android:paddingHorizontal="8dp" />

        <!--
          Estado VACÍO (punto 4.A del contrato). Con setEmptyView() en Java,
          Android alterna solo entre lvClientes y este TextView según si el
          adaptador tiene 0 elementos. Integrante 1 solo necesita agregar:
            lvClientes.setEmptyView(findViewById(R.id.tvClientesEmpty));
        -->
        <TextView
            android:id="@+id/tvClientesEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="Sin clientes registrados"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== FORMULARIO: mitad inferior, tarjeta fija ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Nombre / razón social -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                    app:startIconTint="@color/colorPrimary"
                    app:boxStrokeColor="@color/colorPrimary"
                    app:hintTextColor="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etClienteNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="Nombre / Razón Social"
                        android:inputType="textPersonName"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Dirección -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:startIconDrawable="@android:drawable/ic_menu_mapmode"
                    app:startIconTint="@color/colorPrimary"
                    app:boxStrokeColor="@color/colorPrimary"
                    app:hintTextColor="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etClienteDireccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="Dirección física"
                        android:inputType="textPostalAddress"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Teléfono -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:startIconDrawable="@android:drawable/ic_menu_call"
                    app:startIconTint="@color/colorPrimary"
                    app:boxStrokeColor="@color/colorPrimary"
                    app:hintTextColor="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etClienteTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="Teléfono contacto"
                        android:inputType="phone"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveCliente"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:minHeight="48dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="10dp"
                        android:text="Guardar"
                        android:textSize="14sp"
                        android:backgroundTint="@color/colorSuccess"
                        app:icon="@drawable/ic_save"
                        app:iconTint="@color/white"
                        app:iconSize="18dp"
                        app:iconPadding="4dp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditCliente"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:minHeight="48dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="10dp"
                        android:enabled="false"
                        android:text="Editar"
                        android:textSize="14sp"
                        android:backgroundTint="@color/btn_edit_tint"
                        app:icon="@drawable/ic_edit"
                        app:iconTint="@color/white"
                        app:iconSize="18dp"
                        app:iconPadding="4dp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeleteCliente"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:minHeight="48dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="10dp"
                        android:enabled="false"
                        android:text="Eliminar"
                        android:textSize="14sp"
                        android:backgroundTint="@color/btn_delete_tint"
                        app:icon="@drawable/ic_delete"
                        app:iconTint="@color/white"
                        app:iconSize="18dp"
                        app:iconPadding="4dp"
                        app:cornerRadius="12dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

</LinearLayout>