<?xml version="1.0" encoding="utf-8"?>
<!--
  Gestión de técnicos (RF-20, hash+salt, usuario único). API-first, Fase 5.
  Mismo patrón de activity_clientes.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- ===== ENCABEZADO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorPrimary"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTecnicosTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestión de Técnicos"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== INDICADORES DE ESTADO (API) ===== -->
    <ProgressBar
        android:id="@+id/pbTecnicos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvTecnicosError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/colorError"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- ===== LISTADO ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvTecnicos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/colorDivider"
            android:dividerHeight="1dp"
            android:paddingHorizontal="8dp" />

        <TextView
            android:id="@+id/tvTecnicosEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="Sin técnicos registrados"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== FORMULARIO ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Nombre completo -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                    app:startIconTint="@color/colorPrimary"
                    app:boxStrokeColor="@color/colorPrimary"
                    app:hintTextColor="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTecnicoNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="Nombre completo"
                        android:inputType="textPersonName"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Usuario de acceso: único en el sistema -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:startIconDrawable="@android:drawable/ic_menu_edit"
                    app:startIconTint="@color/colorPrimary"
                    app:boxStrokeColor="@color/colorPrimary"
                    app:hintTextColor="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTecnicoUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="Usuario de acceso"
                        android:inputType="text"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!--
                  Contraseña: SIEMPRE queda vacía al cargar el formulario,
                  tanto en modo creación como en modo edición (RFN-05).
                  La lógica decide qué hacer con este campo:
                    - Vacío al crear -> bloquea el guardado (obligatorio).
                    - Vacío al editar -> no cambia la contraseña existente.
                    - Con texto -> se hashea y se envía a la API.
                  El XML no distingue esos casos, solo expone el ID.
                -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:startIconDrawable="@android:drawable/ic_lock_lock"
                    app:startIconTint="@color/colorPrimary"
                    app:boxStrokeColor="@color/colorPrimary"
                    app:hintTextColor="@color/colorPrimary"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTecnicoPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="Contraseña (solo al cambiar)"
                        android:inputType="textPassword"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveTecnico"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:minHeight="48dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="10dp"
                        android:text="Guardar"
                        android:textSize="14sp"
                        android:backgroundTint="@color/colorSuccess"
                        app:icon="@drawable/ic_save"
                        app:iconTint="@color/white"
                        app:iconSize="18dp"
                        app:iconPadding="4dp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditTecnico"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:minHeight="48dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="10dp"
                        android:enabled="false"
                        android:text="Editar"
                        android:textSize="14sp"
                        android:backgroundTint="@color/btn_edit_tint"
                        app:icon="@drawable/ic_edit"
                        app:iconTint="@color/white"
                        app:iconSize="18dp"
                        app:iconPadding="4dp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeleteTecnico"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:minHeight="48dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="10dp"
                        android:enabled="false"
                        android:text="Eliminar"
                        android:textSize="14sp"
                        android:backgroundTint="@color/btn_delete_tint"
                        app:icon="@drawable/ic_delete"
                        app:iconTint="@color/white"
                        app:iconSize="18dp"
                        app:iconPadding="4dp"
                        app:cornerRadius="12dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

</LinearLayout>