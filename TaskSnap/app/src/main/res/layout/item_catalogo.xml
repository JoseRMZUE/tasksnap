<?xml version="1.0" encoding="utf-8"?>
<!--
  Fila reutilizable para lvClientes, lvServicios y lvTecnicos (v1.1, punto 7).
  Mismo patrón de item_orden.xml: bloque principal + badge a la derecha.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvItemEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_badge_activo"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="Activo"
        android:textColor="@color/colorSuccess"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>