<?xml version="1.0" encoding="utf-8"?>
<!--
  Galeria de evidencias de una orden: ver miniaturas y eliminar (RN-6).
  Mismo patron visual de activity_servicios.xml / activity_clientes.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- ===== ENCABEZADO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorPrimary"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvEvidenciasTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Evidencias"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== GALERIA ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/gvEvidencias"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="2"
            android:horizontalSpacing="4dp"
            android:verticalSpacing="4dp"
            android:padding="8dp"
            android:stretchMode="columnWidth" />

        <TextView
            android:id="@+id/tvEvidenciasEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="Esta orden no tiene evidencias registradas"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>