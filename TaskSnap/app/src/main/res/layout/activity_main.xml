<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla principal: CRUD de órdenes (RF-05 y siguientes).
  Contrato de Interfaces v1.1 — Integrante 2 (UI/UX).
  Todos los IDs abajo ya son consumidos por MainActivity.java.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- ===== ENCABEZADO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorPrimary"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TaskSnap"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUsuarioSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sesión: —"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir menú"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <!-- ===== FORMULARIO (con scroll, por si la pantalla es chica) ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- N.º orden / buscar: doble propósito (RN-5 / UD-01) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:startIconDrawable="@drawable/ic_assignment"
                app:startIconTint="@color/colorPrimary"
                app:boxStrokeColor="@color/colorPrimary"
                app:hintTextColor="@color/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOrderNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:hint="N.º orden / Buscar"
                    android:inputType="number"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Spinner: Tipo de servicio (se llena desde caché local en Java) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Tipo de servicio"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spnTipoServicio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@android:drawable/btn_dropdown"
                android:spinnerMode="dropdown" />

            <!-- Spinner: Cliente (idéntico patrón) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Cliente"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spnCliente"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@android:drawable/btn_dropdown"
                android:spinnerMode="dropdown" />

            <!-- Descripción: multilínea, obligatoria -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:startIconDrawable="@drawable/ic_notes"
                app:startIconTint="@color/colorPrimary"
                app:boxStrokeColor="@color/colorPrimary"
                app:hintTextColor="@color/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:gravity="top"
                    android:hint="Descripción"
                    android:inputType="textMultiLine"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--
              Fecha de servicio: texto libre con formato ISO por ahora.
              inputType="text" a propósito (no "date"): el compañero conectará
              un DatePickerDialog más adelante; si le ponemos inputType="date"
              ahora, el teclado numérico que aparece no coincide con el
              formato yyyy-MM-dd que pide el hint, y confundiría al usuario.
            -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:startIconDrawable="@drawable/ic_calendar"
                app:startIconTint="@color/colorPrimary"
                app:boxStrokeColor="@color/colorPrimary"
                app:hintTextColor="@color/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etServiceDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:hint="Fecha (yyyy-MM-dd)"
                    android:inputType="text"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Spinner: Estado (Java pone PENDIENTE/COMPLETADA, ver adapterEstados) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Estado"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spnStatus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@android:drawable/btn_dropdown"
                android:spinnerMode="dropdown" />

            <!-- ===== ZONA DE EVIDENCIA FOTOGRÁFICA ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/ivEvidence"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:background="@color/colorDivider"
                        android:contentDescription="Evidencia fotográfica de la orden"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCamera"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tomar foto"
                            android:textSize="14sp"
                            android:minHeight="48dp"
                            android:backgroundTint="@color/colorPrimary"
                            app:icon="@drawable/ic_camera"
                            app:iconTint="@color/white"
                            app:cornerRadius="12dp" />

                        <TextView
                            android:id="@+id/tvEvidenceCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Evidencias: 0"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVerEvidencias"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Ver evidencias"
                            android:textSize="12sp"
                            android:minHeight="40dp"
                            android:backgroundTint="@color/colorPrimary"
                            app:icon="@drawable/ic_list"
                            app:iconTint="@color/white"
                            app:iconSize="16dp"
                            app:cornerRadius="10dp" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== BOTONES CRUD ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:minHeight="48dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="10dp"
                    android:text="Guardar"
                    android:textSize="14sp"
                    android:backgroundTint="@color/colorSuccess"
                    app:icon="@drawable/ic_save"
                    app:iconTint="@color/white"
                    app:iconSize="18dp"
                    app:iconPadding="4dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:minHeight="48dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="10dp"
                    android:enabled="false"
                    android:text="Editar"
                    android:textSize="14sp"
                    android:backgroundTint="@color/btn_edit_tint"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="@color/white"
                    app:iconSize="18dp"
                    app:iconPadding="4dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:minHeight="48dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="10dp"
                    android:enabled="false"
                    android:text="Eliminar"
                    android:textSize="14sp"
                    android:backgroundTint="@color/btn_delete_tint"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/white"
                    app:iconSize="18dp"
                    app:iconPadding="4dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- ===== BOTONES DE NAVEGACIÓN / FILTRO ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearch"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:minHeight="48dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="10dp"
                    android:text="Buscar"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_search"
                    app:iconTint="@color/colorPrimary"
                    app:iconSize="18dp"
                    app:iconPadding="4dp"
                    app:strokeColor="@color/colorPrimary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnListing"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:minHeight="48dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="10dp"
                    android:text="Listar"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_list"
                    app:iconTint="@color/colorPrimary"
                    app:iconSize="18dp"
                    app:iconPadding="4dp"
                    app:strokeColor="@color/colorPrimary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearFields"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:minHeight="48dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="10dp"
                    android:text="Limpiar"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_clear"
                    app:iconTint="@color/colorPrimary"
                    app:iconSize="18dp"
                    app:iconPadding="4dp"
                    app:strokeColor="@color/colorPrimary"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== LISTADO: ocupa todo el espacio restante ===== -->
    <ListView
        android:id="@+id/lvList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/colorDivider"
        android:dividerHeight="1dp"
        android:paddingHorizontal="8dp" />

</LinearLayout>